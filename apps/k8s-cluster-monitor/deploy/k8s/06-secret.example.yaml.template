# TEMPLATE ONLY — placeholder values. Never commit real credentials.
#
# Create the real Secret imperatively at deploy time instead of applying
# this file, e.g.:
#
#   kubectl create secret generic k8s-cluster-monitor-auth \
#     -n k8s-cluster-monitor \
#     --from-literal=BASIC_AUTH_USERNAME=<choose-a-username> \
#     --from-literal=BASIC_AUTH_PASSWORD="$(openssl rand -base64 24)"
#
# and note the generated password somewhere safe (a password manager, not
# this repo) — kubectl will not print it back to you afterwards.
apiVersion: v1
kind: Secret
metadata:
  name: k8s-cluster-monitor-auth
  namespace: k8s-cluster-monitor
type: Opaque
stringData:
  BASIC_AUTH_USERNAME: "CHANGE-ME"
  BASIC_AUTH_PASSWORD: "CHANGE-ME"
