# NOT applied by default (note the .disabled extension — `kubectl apply -f
# deploy/k8s/` skips files that aren't .yaml/.yml/.json).
#
# This dashboard shows live cluster security/health posture behind nothing
# more than Basic Auth. This cluster's own audit (2026-07-19) flagged
# exactly this combination — a powerful tool combined with public exposure —
# as a HIGH risk finding for the Headlamp dashboard. Don't repeat it here.
#
# If you still want external access, rename this file to 10-httproute.yaml,
# fill in a real hostname, and apply it deliberately — ideally in addition
# to (not instead of) Basic Auth, and after considering an oauth2-proxy or
# equivalent SSO layer in front of it instead of raw Basic Auth for a
# publicly reachable route.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: k8s-cluster-monitor
  namespace: k8s-cluster-monitor
spec:
  parentRefs:
    - name: gateway
      namespace: default
  hostnames:
    - "CHANGE-ME.studiobasa.com"
  rules:
    - backendRefs:
        - name: k8s-cluster-monitor
          port: 80
